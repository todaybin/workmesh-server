[Unit]
Description=WorkMesh Server
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=@WORKMESH_SERVER_ROOT@
ExecCondition=/usr/bin/test -x @WORKMESH_SERVER_ROOT@/bin/workmesh-server
ExecStart=@WORKMESH_SERVER_ROOT@/bin/workmesh-server
EnvironmentFile=-@WORKMESH_SERVER_ROOT@/config/server.env
Restart=on-failure
RestartSec=5s
UMask=0027
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
