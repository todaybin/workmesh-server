[Unit]
Description=Run WorkMesh Server signed release updater periodically

[Timer]
OnBootSec=15min
OnUnitActiveSec=6h
RandomizedDelaySec=15min
Persistent=true
Unit=workmesh-server-update.service

[Install]
WantedBy=timers.target
