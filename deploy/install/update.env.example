# Copy to /opt/workmesh-server/config/update.env and set mode 0600.
# Automatic updates are disabled unless explicitly enabled.
WORKMESH_AUTO_UPDATE_ENABLED=0

# Use HTTPS URLs for remote updates:
# WORKMESH_UPDATE_ARTIFACT_URL=https://updates.example.com/workmesh-server-linux-amd64
# WORKMESH_UPDATE_SIGNATURE_URL=https://updates.example.com/workmesh-server-linux-amd64.sig

# Or use root-owned local files:
# WORKMESH_UPDATE_ARTIFACT_PATH=/opt/workmesh-server/releases/workmesh-server-linux-amd64
# WORKMESH_UPDATE_SIGNATURE_PATH=/opt/workmesh-server/releases/workmesh-server-linux-amd64.sig

# Or use a signed JSON manifest (manifest URL fields are HTTPS):
# WORKMESH_UPDATE_MANIFEST_URL=https://updates.example.com/release-manifest.json
# WORKMESH_UPDATE_MANIFEST_SIGNATURE_URL=https://updates.example.com/release-manifest.json.sig
# The manifest must include: version, os, arch, size, sha256,
# artifact_url and signature_url.

# Raw/base64/hex Ed25519 public key, or a root-owned key file path.
# WORKMESH_UPDATE_PUBLIC_KEY=
# Optional defense-in-depth expected digest and release label.
# WORKMESH_UPDATE_SHA256=
# WORKMESH_UPDATE_VERSION=
