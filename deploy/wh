#!/usr/bin/env bash
set -Eeuo pipefail
ROOT_DIR="${WORKMESH_SERVER_ROOT:-/opt/workmesh-server}"
export WORKMESH_SERVER_CONFIG="${WORKMESH_SERVER_CONFIG:-$ROOT_DIR/config/server.json}"
export WORKMESH_DATA_DIR="${WORKMESH_DATA_DIR:-$ROOT_DIR/data}"
if [[ -f "$ROOT_DIR/config/server.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT_DIR/config/server.env"
  set +a
fi
if [[ $# -eq 0 ]]; then
  exec "$ROOT_DIR/bin/workmesh-server" help
fi
exec "$ROOT_DIR/bin/workmesh-server" "$@"
